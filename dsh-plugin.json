{
  "$schema": "https://dsh.community/schemas/dsh-plugin-0.15.json",
  "manifestVersion": "0.15",
  "id": "com.dsh-tui-ecosystem.dsh-peak-balance",
  "name": "dsh-peak-balance",
  "version": "0.1.11",
  "facets": {
    "host": {
      "entry": "lib/index.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "tui.dsh/v1alpha1",
        "kind": "DecisionEvents",
        "optional": true,
        "fallback": "Without the mediated session-switch notification the status line follows the host's focused-session marker (~/.dsh-tui/resume.txt), polled once a second; without a marker it keeps the most recent session event."
      }
    ]
  },
  "permissions": [],
  "subscriptions": [],
  "contributes": {
    "commands": []
  },
  "compat": {
    "hosts": [
      "dsh-tui"
    ]
  },
  "license": "MIT",
  "source": {
    "repository": "https://github.com/VviLliAm-qwq/dsh-peak-balance"
  }
}
